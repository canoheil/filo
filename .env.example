# Telegram
BOT_TOKEN=123456:PASTE_TOKEN_FROM_BOTFATHER

# MariaDB on cPanel (Database Wizard) — utf8mb4 is required for Persian
DATABASE_URL=mysql+asyncmy://CPANELUSER_secretary:CHANGE_ME@localhost:3306/CPANELUSER_secretary?charset=utf8mb4

# Google AI Studio (Gemma 4) — https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_AI_STUDIO_KEY
GEMMA_MODEL=gemma-4-26b-it
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Product limits
FREE_DAILY_LIMIT=30
LOG_LEVEL=INFO

# Comma-separated admin Telegram IDs
# Numeric Telegram owner IDs, comma-separated; restart after editing. Private /admin only.
ADMIN_IDS=

# Draft policy: original creation time, edits do not extend the send deadline.
DRAFT_TTL_MINUTES=60
# Must exceed DRAFT_TTL_MINUTES in duration. Error/orphan text only; metadata remains.
DRAFT_ERROR_RETENTION_HOURS=24

# Required support membership. Empty disables the gate.
# Public channel: @filo_support OR https://t.me/filo_support
SUPPORT_CHANNEL=
# For a private channel set SUPPORT_CHANNEL=-1001234567890 and provide its invite URL below.
# The bot must be an administrator of the configured channel.
SUPPORT_CHANNEL_JOIN_URL=

# After first startup of the admin panel, membership channels are managed in DB via /admin.
# SUPPORT_CHANNEL is a one-time seed, not a permanent override. See docs/admin-panel.md.

# Phase 1 input admission: shared ordinary message/callback budget per bot/user.
INPUT_RATE_SECONDS=0.8
# Maximum live keys PER lane (ordinary + separately bounded safety lane).
INPUT_RATE_MAX_USERS=4096

# Phase 2: shared business/sandbox AI admission (one polling process).
AI_MAX_CONCURRENT=4
AI_OWNER_MAX_CONCURRENT=1
AI_CHAT_INTERVAL_SECONDS=2
AI_OWNER_INTERVAL_SECONDS=1
AI_GLOBAL_INTERVAL_SECONDS=0.2
AI_GUARD_MAX_KEYS=4096
AI_BUSINESS_MAX_CHARS=6000
AI_REQUEST_TIMEOUT_SECONDS=75

# Phase 3: one shared Telegram outbound limiter (single polling process).
OUTBOUND_GLOBAL_INTERVAL_SECONDS=0.05
OUTBOUND_CHAT_INTERVAL_SECONDS=1.05
OUTBOUND_GROUP_INTERVAL_SECONDS=3.1
OUTBOUND_MAX_CHATS=8192
OUTBOUND_MAX_INFLIGHT=16
OUTBOUND_MAX_WAITERS=128
OUTBOUND_MAX_WAIT_SECONDS=3
